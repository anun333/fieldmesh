# SPDX-License-Identifier: Apache-2.0
# The foundation's side of the module socket (spec v0.1 §8.3; Q11), over the farm's log.
# Other processes append to the same log file — the radio or MQTT ingest, `modhost.py
# grant` and `revoke`, the token tool — and the host reads them back every two seconds,
# so a new grant, a revocation or a reading counts without a restart.

[Unit]
Description=fieldmesh module host

[Service]
Type=simple
User=fieldmesh
Group=fieldmesh-modules
ExecStart=/usr/bin/python3 -I /opt/fieldmesh/sdk/modhost.py serve \
    --log /var/lib/fieldmesh/farm.jsonl --socket /run/fieldmesh/modules.sock
StateDirectory=fieldmesh
RuntimeDirectory=fieldmesh
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5s
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
